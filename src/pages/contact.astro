                <ul>
                    <li>LinkedIn - <a href="https://www.linkedin.com/in/nicknettleton/" target="_blank">www.linkedin.com/in/nicknettleton/</a></li>
                    <li>Urgent/Sensitive Matters - +44 7811 279 399</li>
                    <li>General Enquiries - <a id="emla"></a></li>
                </ul>
                
            </div>
        </div>
    </section>

</MasterLayout>
